rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /test/{document=**} {
      allow read, write: if true;
    }

    // Students collection: academic, biodata, and bursary records
    match /students/{studentId} {
      allow read: if isValidId(studentId);
      allow list: if true;
      allow write: if isValidId(studentId);
    }

    // Faculty and Staff roster
    match /staff/{staffId} {
      allow read: if isValidId(staffId);
      allow list: if true;
      allow write: if isValidId(staffId);
    }

    // Academic class arms
    match /classes/{classId} {
      allow read: if isValidId(classId);
      allow list: if true;
      allow write: if isValidId(classId);
    }

    // Official announcements
    match /announcements/{announcementId} {
      allow read: if isValidId(announcementId);
      allow list: if true;
      allow write: if isValidId(announcementId);
    }

    // System configurations and fee schedules
    match /system/{systemDocId} {
      allow read, write: if isValidId(systemDocId);
    }

    // Attendance registers
    match /attendance/{attendanceId} {
      allow read: if isValidId(attendanceId);
      allow list: if true;
      allow write: if isValidId(attendanceId);
    }
  }
}

